# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Telegram-бот ---
# Токен от @BotFather
BOT_TOKEN=123456789:replace-with-your-token
BOT_SERVICE_URL=http://127.0.0.1:8000

# --- Сервис инференса ---
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
# a1111 — Stable Diffusion web UI, dummy — заглушка без GPU
SERVICE_BACKEND=a1111
SERVICE_A1111_URL=http://127.0.0.1:7860
SERVICE_DEFAULT_STEPS=20
SERVICE_DEFAULT_SAMPLER=Euler a
